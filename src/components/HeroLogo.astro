---
// The NIBF roundel rendered in 3D and draggable.
// three.js is ~600KB, so it is imported dynamically: Vite code-splits it into
// its own chunk that only the homepage ever requests. It must never end up in
// the shared bundle.
---

<div data-hero-stage>
  <div data-hero-3d></div>
  <span class="hero__hint">pak vast en draai</span>
</div>

<script>
  const mount = document.querySelector<HTMLElement>('[data-hero-3d]');
  const motion = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (mount) {
    import('three')
      .then((THREE) => {
        if (!mount.isConnected) return;

        // Matches --primary. The light halves are a faintly cool off-white so
        // the mark still separates from the white page.
        const PRIMARY = 0x1c2839;
        const OFFWHITE = 0xf6f7f9;
        const R = 1;
        const r = 0.5;
        const depth = 0.34;

        const halfRing = () => {
          const s = new THREE.Shape();
          s.absarc(0, 0, R, 0, Math.PI, false);
          s.lineTo(-r, 0);
          s.absarc(0, 0, r, Math.PI, 0, true);
          s.closePath();
          return s;
        };

        const halfDisc = () => {
          const s = new THREE.Shape();
          s.absarc(0, 0, r, 0, Math.PI, false);
          s.closePath();
          return s;
        };

        const extrude = (shape: InstanceType<typeof THREE.Shape>) => {
          const g = new THREE.ExtrudeGeometry(shape, {
            depth,
            bevelEnabled: true,
            bevelThickness: 0.02,
            bevelSize: 0.02,
            bevelSegments: 2,
            curveSegments: 72,
          });
          g.translate(0, 0, -depth / 2);
          g.computeVertexNormals();
          return g;
        };

        const mat = (color: number) =>
          new THREE.MeshStandardMaterial({ color, roughness: 0.42, metalness: 0.06 });

        const group = new THREE.Group();
        const parts: [InstanceType<typeof THREE.Shape>, number, number][] = [
          [halfRing(), PRIMARY, 0],
          [halfRing(), OFFWHITE, Math.PI],
          [halfDisc(), OFFWHITE, 0],
          [halfDisc(), PRIMARY, Math.PI],
        ];
        for (const [shape, color, rot] of parts) {
          const m = new THREE.Mesh(extrude(shape), mat(color));
          m.rotation.z = rot;
          group.add(m);
        }

        group.add(
          new THREE.Mesh(
            new THREE.TorusGeometry(R + 0.005, 0.012, 8, 96),
            new THREE.MeshStandardMaterial({ color: PRIMARY, roughness: 0.5 })
          )
        );

        const scene = new THREE.Scene();
        scene.add(group);
        scene.add(new THREE.AmbientLight(0xffffff, 0.72));
        // Cool sky, cool ground -- the old values were tinted toward the
        // previous blue and read slightly purple against slate.
        scene.add(new THREE.HemisphereLight(0xe6ebf2, 0xc6ccd6, 0.55));

        const key = new THREE.DirectionalLight(0xffffff, 1.5);
        key.position.set(2.6, 3.4, 4.2);
        scene.add(key);

        // The fill is warm, drawn from --accent. It is the one place the two
        // brand colours meet: the mark stays primary and off-white, but the
        // light bouncing into its shadows is terracotta, so the accent is
        // present in the signature element without the mark being painted
        // orange. Kept low so the off-white halves do not look dirty.
        const fill = new THREE.DirectionalLight(0xd9a472, 0.42);
        fill.position.set(-3, -1.5, 2);
        scene.add(fill);

        const camera = new THREE.PerspectiveCamera(34, 1, 0.1, 100);
        camera.position.set(0, 0, 5.4);

        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setClearAlpha(0);
        renderer.setPixelRatio(Math.min(2, window.devicePixelRatio || 1));
        renderer.domElement.style.cssText = 'display:block; width:100%; height:100%;';
        mount.appendChild(renderer.domElement);

        const resize = () => {
          const w = mount.clientWidth || 400;
          const h = mount.clientHeight || 400;
          renderer.setSize(w, h, false);
          camera.aspect = w / h;
          camera.updateProjectionMatrix();
        };
        resize();
        new ResizeObserver(() => {
          resize();
          kick();
        }).observe(mount);

        // Rest pose. With reduced motion this is where it stays, which is what
        // makes the homepage screenshot deterministic.
        const cur = { y: 0, x: -0.18 };
        const target = { x: -0.18 };

        let dragging = false;
        let lastX = 0;
        let lastY = 0;
        let lastT = 0;

        const BASE = 0.3;
        let vel = BASE;
        let idleDir = 1;

        const el = renderer.domElement;
        el.style.cursor = 'grab';
        el.style.touchAction = 'none';

        el.addEventListener('pointerdown', (e) => {
          if (!motion) return;
          dragging = true;
          lastX = e.clientX;
          lastY = e.clientY;
          lastT = performance.now();
          vel = 0;
          el.style.cursor = 'grabbing';
          el.setPointerCapture?.(e.pointerId);
          kick();
        });

        el.addEventListener('pointermove', (e) => {
          if (!dragging) return;
          const now = performance.now();
          const dt = Math.max(0.008, (now - lastT) / 1000);
          const dy = (e.clientX - lastX) * 0.011;
          cur.y += dy;
          cur.x = Math.max(-0.7, Math.min(0.7, cur.x + (e.clientY - lastY) * 0.006));
          vel = Math.max(-9, Math.min(9, dy / dt));
          kick();
          lastX = e.clientX;
          lastY = e.clientY;
          lastT = now;
        });

        const release = () => {
          if (!dragging) return;
          dragging = false;
          el.style.cursor = 'grab';
          if (Math.abs(vel) > 0.06) idleDir = Math.sign(vel);
          else vel = idleDir * BASE;
          target.x = -0.18;
        };
        el.addEventListener('pointerup', release);
        el.addEventListener('pointercancel', release);
        el.addEventListener('lostpointercapture', release);

        // The loop used to run at 60fps forever -- off-screen, in a
        // background tab, and with reduced motion where the pose never
        // changes. That is a constant GPU cost, and it competed with the nav
        // drawer's slide, which is what made the tap feel like it stuttered.
        // Now frames are only requested when something is actually moving.
        let onScreen = true;
        let navOpen = false;
        let rafId = 0;

        const wants = () =>
          onScreen && !document.hidden && !navOpen && (motion || dragging);

        let prev = performance.now();
        const draw = (t: number) => {
          const dt = Math.min(0.05, (t - prev) / 1000);
          prev = t;
          if (!dragging && motion) {
            vel += (idleDir * BASE - vel) * (1 - Math.exp(-dt * 1.5));
            cur.y += vel * dt;
            cur.x += (target.x - cur.x) * 0.08;
          }
          group.rotation.y = cur.y;
          group.rotation.x = cur.x;
          renderer.render(scene, camera);
          rafId = wants() ? requestAnimationFrame(draw) : 0;
        };

        // Always paints at least one frame, so a reduced-motion or paused
        // hero still shows the mark rather than an empty box.
        const kick = () => {
          if (rafId) return;
          prev = performance.now();
          rafId = requestAnimationFrame(draw);
        };

        new IntersectionObserver(([e]) => {
          onScreen = e.isIntersecting;
          kick();
        }).observe(mount);

        document.addEventListener('visibilitychange', kick);
        document.addEventListener('nibf:nav', (e) => {
          navOpen = !!(e as CustomEvent).detail?.open;
          kick();
        });

        kick();
      })
      .catch((err) => {
        console.warn('three.js kon niet laden', err);
      });
  }
</script>
