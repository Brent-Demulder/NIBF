---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';

// The five listed publications were invented for the mockup and have been
// removed. The .lib__* row design stays in global.css, ready for real entries.
---

<BaseLayout
  title="Bibliotheek — NIBF"
  path="/bibliotheek"
  description="Geschreven werk van Nisrine Bolakhrif."
>
  <section class="section--page">
    <Eyebrow text="03 — Bibliotheek" />
    <h1 class="h1 h1--page">Geschreven werk</h1>
    <p class="page-intro">Novellen, essays, poëzie en korte verhalen.</p>

    <p class="empty">Deze bibliotheek wordt binnenkort gevuld.</p>
  </section>
</BaseLayout>

<style>
  .page-intro {
    max-width: 56ch;
    margin: 0 0 48px;
  }
</style>
