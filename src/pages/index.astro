---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import HeroLogo from '../components/HeroLogo.astro';
import WorkCard from '../components/WorkCard.astro';
---

<BaseLayout
  title="NIBF — Nisrine Bolakhrif"
  path="/"
  description="Beeldend werk en geschreven werk van Nisrine Bolakhrif."
>
  <section class="section--hero">
    <Eyebrow text="NIBF — Kunst & literatuur" />

    <div data-hero-grid>
      <div>
        <h1 class="h1">Nisrine<br />Bolakhrif</h1>
        <p class="lede">Beeldend werk en geschreven werk, onder één naam.</p>
        <p class="intro">
          Hier vind je de bibliotheek met teksten, de galerij met beeldend werk, en de afspraken
          over gebruik en auteursrecht.
        </p>
        <div class="btn-row">
          <a href="/kunst-gallerij" class="btn btn--primary">
            Bekijk de galerij <span class="arrow">→</span>
          </a>
          <a href="/contact" class="btn btn--ghost">Contact</a>
        </div>
      </div>

      <HeroLogo />
    </div>
  </section>

  <section class="section section--rule section--panel">
    <Eyebrow text="Het werk" rule={false} />
    <div class="card-grid">
      <WorkCard href="/kunst-gallerij" num="04" title="Kunst gallerij">
        Beeldend werk, gebundeld per project en thema.
      </WorkCard>
      <WorkCard href="/bibliotheek" num="03" title="Bibliotheek">
        Geschreven werk, chronologisch geordend.
      </WorkCard>
      <WorkCard href="/auteursrechten" num="02" title="Auteursrechten">
        Wat wel en niet mag zonder toestemming.
      </WorkCard>
    </div>
  </section>
</BaseLayout>
