---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';

// Becomes a `kunstwerken` collection query in Phase 3.
const werken = [
  {
    titel: 'Herhaling I–VI',
    jaar: '2025 · doek',
    caption: 'serie — 6 doeken, 120×90 cm',
    ratio: 'placeholder--16x10',
    stripe: '',
    parallax: '0.04',
    wide: true,
  },
  {
    titel: 'Kamerstudie',
    jaar: '2024 · papier',
    caption: 'werk op papier',
    ratio: 'placeholder--3x4',
    stripe: 'placeholder--gold',
    parallax: '0.07',
    wide: false,
  },
  {
    titel: 'Grondtoon',
    jaar: '2023 · installatie',
    caption: 'installatie, detail',
    ratio: 'placeholder--1x1',
    stripe: 'placeholder--s09',
    parallax: '0.05',
    wide: false,
  },
  {
    titel: 'Wat de kamer onthield',
    jaar: '2024 · expositie',
    caption: 'tentoonstellingsoverzicht',
    ratio: 'placeholder--16x9',
    stripe: 'placeholder--s13',
    parallax: '0.03',
    wide: true,
  },
];

const filters = ['Alles', 'Herinnering', 'Papier', 'Doek'];
---

<BaseLayout
  title="Kunst gallerij — NIBF"
  path="/kunst-gallerij"
  description="Beeldend werk van Nisrine Bolakhrif, gebundeld per project en thema. Doek, papier en installatie."
>
  <section class="section--page">
    <Eyebrow text="04 — Kunst gallerij" />
    <h1 class="h1 h1--page">Werk per project en thema</h1>

    <div class="chips">
      {
        filters.map((f, i) => (
          <span class:list={['chip', i === 0 && 'chip--active']}>{f}</span>
        ))
      }
    </div>

    <div data-gallery-grid>
      {
        werken.map((w) => (
          <a
            href="/kunst-gallerij"
            data-tilt
            class:list={['tile', 'tiltable', w.wide && 'tile--wide']}
          >
            <div
              data-parallax={w.parallax}
              class:list={['placeholder', w.ratio, w.stripe]}
            >
              <span class="placeholder__caption">{w.caption}</span>
            </div>
            {
              w.wide ? (
                <div class="tile__meta">
                  <span class="tile__title">{w.titel}</span>
                  <span class="tile__year">{w.jaar}</span>
                </div>
              ) : (
                <div class="tile__sub">
                  <div class="tile__title">{w.titel}</div>
                  <div class="tile__kind">{w.jaar}</div>
                </div>
              )
            }
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  h1 {
    max-width: 22ch;
  }
</style>
