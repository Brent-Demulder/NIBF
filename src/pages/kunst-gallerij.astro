---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';

// The four listed works were invented for the mockup and have been removed,
// along with the Herinnering/Papier/Doek filters that categorised them. The
// filter implementation is in git history at 6e41e90 and comes back once real
// work exists to tag. What remains are empty frames showing the grid.
const frames = [
  { ratio: 'placeholder--16x10', stripe: '', wide: true },
  { ratio: 'placeholder--3x4', stripe: 'placeholder--gold', wide: false },
  { ratio: 'placeholder--1x1', stripe: 'placeholder--s09', wide: false },
];
---

<BaseLayout
  title="Kunst gallerij — NIBF"
  path="/kunst-gallerij"
  description="Beeldend werk van Nisrine Bolakhrif."
>
  <section class="section--page">
    <Eyebrow text="04 — Kunst gallerij" />
    <h1 class="h1 h1--page">Beeldend werk</h1>
    <p class="page-intro">Werk op doek, papier en in installatie.</p>

    <div data-gallery-grid>
      {
        frames.map((f) => (
          <div class:list={['tile', f.wide && 'tile--wide']}>
            <div class:list={['placeholder', f.ratio, f.stripe]} />
          </div>
        ))
      }
    </div>

    <p class="empty">Deze galerij wordt binnenkort gevuld.</p>
  </section>
</BaseLayout>

<style>
  .page-intro {
    max-width: 56ch;
    margin: 0 0 40px;
  }

  .empty {
    margin-top: 40px;
  }
</style>
